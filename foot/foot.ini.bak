[main]
font=Iosevka:size=12
font-bold=Iosevka:weight=bold:size=12
font-italic=Iosevka:slant=oblique:size=12
font-bold-italic=Iosevka:weight=bold:slant=oblique:size=12
line-height=14
letter-spacing=0
pad=12x12 center
dpi-aware=no
term=foot

[scrollback]
lines=10000

[cursor]
style=block
blink=yes
color=252525 ffffff

[mouse]
hide-when-typing=yes

[colors]
alpha=0.88
foreground=ffffff
background=252525
selection-foreground=252525
selection-background=f5e0dc
urls=89b4fa

regular0=45475a
regular1=f38ba8
regular2=a6e3a1
regular3=f9e2af
regular4=89b4fa
regular5=f5c2e7
regular6=94e2d5
regular7=bac2de

bright0=585b70
bright1=f38ba8
bright2=a6e3a1
bright3=f9e2af
bright4=89b4fa
bright5=f5c2e7
bright6=94e2d5
bright7=a6adc8

[key-bindings]
font-increase=Control+plus Control+equal
font-decrease=Control+minus
font-reset=Control+0
