general {
    output_format = "i3bar"
    colors = true
    interval = 1
    color_good = "#00ff9f"
    color_degraded = "#ffaa00"
    color_bad = "#ff0055"
    separator = "│"
}

order += "cpu_usage"
order += "load"
order += "cpu_temperature 0"
order += "cpu_temperature 1"
order += "memory"
order += "disk /"
order += "disk /home"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "volume master"
order += "tztime local"

cpu_usage {
    format = "◉ %usage"
    max_threshold = 90
    degraded_threshold = 75
}

load {
    format = "⚙ %1min│%5min│%15min"
    max_threshold = 8
}

cpu_temperature 0 {
    format = "🌡 %degrees°"
    path = "/sys/class/thermal/thermal_zone0/temp"
    max_threshold = 80
}


memory {
    format = "▣ %used│%available"
    threshold_degraded = "20%"
    threshold_critical = "10%"
    format_degraded = "▣ MEM LOW: %available"
}

disk "/" {
    format = "▪ %used│%avail"
    threshold_type = "percentage_avail"
    low_threshold = 10
}

disk "/home" {
    format = "▫ %used│%avail"
    threshold_type = "percentage_avail"
    low_threshold = 10
}

wireless _first_ {
    format_up = "📡 %essid %quality│%bitrate│%ip"
    format_down = "📡 ✗"
}

ethernet _first_ {
    format_up = "⚡ %speed│%ip"
    format_down = "⚡ ✗"
}

battery all {
    format = "%status %percentage│%remaining│%consumption"
    format_down = "∅"
    status_chr = "⚡"
    status_bat = "🔋"
    status_unk = "❓"
    status_full = "✓"
    path = "/sys/class/power_supply/BAT%d/uevent"
    low_threshold = 15
    threshold_type = "percentage"
    integer_battery_capacity = true
    hide_seconds = false
}

volume master {
    format = "♫ %volume"
    format_muted = "🔇 %volume"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

tztime local {
    format = "⏰ %Y/%m/%d ◆ %H:%M"
}
