

set $mod Mod4

set $left h
set $down j
set $up k
set $right l

set $term foot
set $menu wofi --show drun --allow-images
set $file dolphin

include ~/.config/sway/output.conf
include ~/.config/sway/bindings.conf
include ~/.config/sway/look.conf
include ~/.config/sway/input.conf

exec /usr/libexec/sway-systemd/session.sh
exec /usr/libexec/sway-systemd/assign-cgroups.py
